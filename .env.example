# Copy to .env for local use, or set these in Vercel → Project → Settings → Environment Variables.

# Required on Vercel: Postgres connection string (Neon / Vercel Postgres / Supabase). Tables are created automatically.
# POSTGRES_URL is accepted too (the Vercel/Neon integration sets it).
# Leave unset locally to use a SQLite file (server/data/industryhead.db).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# TLS certificates of the database are verified. Set to 1 only if your provider uses a private CA that Node does not trust
# (some Supabase pooler setups); prefer adding the CA via NODE_EXTRA_CA_CERTS instead.
# PGSSL_NO_VERIFY=1

# Required for /admin and /api/admin/*: bearer token of any length (longer is harder to guess). Empty, or this placeholder, keeps admin disabled.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: https webhook that receives {"text", "reference"} for every new enquiry (Slack / Teams incoming webhook, Zapier, Make…).
# ENQUIRY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Recommended, used at build time: the live address of the site, no trailing slash. Adds canonical links,
# absolute share-image URLs and sitemap.xml. Set it in Vercel once the custom domain is connected.
# VITE_SITE_URL=https://www.example.com

# Optional, used at build time: public contact address shown in the footer, privacy notice and terms.
# VITE_CONTACT_EMAIL=hello@example.com

# Only for running server/src/index.js on your own host:
# PORT=4000
# NODE_ENV=production
# TRUST_PROXY=1
# DB_PATH=/var/lib/industryhead/industryhead.db
